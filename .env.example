# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# id группы и темы: добавьте бота в группу и напишите /chatid в нужной теме.
# Пусто — бот работает, но только отвечает на команды
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Fine-grained token: Public repositories (read-only), других прав не нужно
GITHUB_TOKEN=
GITHUB_ORG=dejaview-nsu
# Пусто — все репозитории организации
GITHUB_REPOS=dejaview-backend,dejaview-frontend,dejaview-ml,dejaview-infra,dejaview-docs
# Кто в командах из CODEOWNERS: когда ревью просят у команды, бот отмечает её участников.
# GitHub не отдаёт состав команды токену на чтение публичных репозиториев, поэтому он здесь.
# Формат: команда=логин,логин; другая=логин. Команду можно писать как в CODEOWNERS: @org/maintainers
GITHUB_TEAMS=
# Общий префикс репозиториев, который не пишется в сообщениях. По умолчанию — начало GITHUB_ORG до
# дефиса и дефис (dejaview-nsu -> dejaview-); пустое значение — не убирать ничего
# REPO_PREFIX=dejaview-

# all — и успешные, и упавшие сборки; failures — только упавшие
CI_NOTIFY=all
POLL_INTERVAL=60

# Ключ из «Моя учётная запись» в Redmine. Без него в changelog будут ссылки на задачи без тем
REDMINE_URL=https://ai.nsu.ru
REDMINE_API_KEY=
# В какой статус напоминать перевести задачу после слияния PR
TASK_DONE_STATUS=Resolved

# Путь к базе. По умолчанию bot.sqlite3 в папке запуска; в Docker не задавайте: там база в /data
# DB_PATH=bot.sqlite3
TIMEZONE=Asia/Novosibirsk
